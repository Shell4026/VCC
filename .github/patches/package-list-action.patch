+        static async Task<HttpResponseMessage> GetWithRetry(string url)
+        {
+            const int maxAttempts = 6;
+            for (int attempt = 1; ; attempt++)
+            {
+                try
+                {
+                    var response = await Http.GetAsync(url);
+                    if (response.IsSuccessStatusCode || (int)response.StatusCode == 404 || attempt == maxAttempts)
+                    {
+                        return response;
+                    }
+                    Serilog.Log.Warning($"HTTP {(int)response.StatusCode} for {url} (attempt {attempt}/{maxAttempts}), retrying");
+                    response.Dispose();
+                }
+                catch (Exception e) when ((e is HttpRequestException || e is TaskCanceledException) && attempt < maxAttempts)
+                {
+                    Serilog.Log.Warning($"{e.GetType().Name} for {url} (attempt {attempt}/{maxAttempts}): {e.Message}, retrying");
+                }
+                await Task.Delay(TimeSpan.FromSeconds(Math.Min(60, 5 * Math.Pow(2, attempt - 1))));
+            }
+        }
